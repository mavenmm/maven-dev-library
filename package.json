{
  "name": "maven-dev-library",
  "private": true,
  "version": "0.0.0",
  "description": "Maven shared dev-component library — shadcn-style shelf of reusable UI (@mavenmm/ui) + backend logic (@mavenmm/core).",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/ui/tsconfig.json"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
