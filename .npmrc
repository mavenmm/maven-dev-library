@mavenmm:registry=https://npm.pkg.github.com

# Supply-chain cooldown: only install package versions published 14+ days ago
min-release-age=14

# Refuse to install on an npm too old to ENFORCE the cooldown above. Without
# this the line above is decoration on npm 10.x: that version does not know the
# key, ignores it silently, and installs the newest release anyway — so an
# install looks identical whether the cooldown applied or not.
#
# Measured 2026-08-21 against esbuild, whose 0.28.2 was 12 days old (inside the
# window) while 0.28.1 was 70 days old (outside):
#
#   npm 10.8.2,  min-release-age=14 -> esbuild 0.28.2  (ignored)
#   npm 11.10.0, min-release-age=14 -> esbuild 0.28.1  (held back — enforced)
#   npm 11.13.0, min-release-age=14 -> esbuild 0.28.1  (enforced)
#   npm 11.10.0, no cooldown        -> esbuild 0.28.2  (control)
#
# Hence the engines floor of npm >= 11.10.0 in package.json. engine-strict turns
# a too-old npm into a named failure instead of a quiet loss of the control.
#
# Note the floor differs from the consuming apps, which need >= 11.13.0: they
# install this library as a GIT dependency, and npm 11.10.x–11.12.x crash while
# preparing a git dep under a cooldown. This repo has no git dependencies of its
# own, so 11.10.0 is the honest floor here. Raise it to 11.13.0 if that changes.
engine-strict=true
